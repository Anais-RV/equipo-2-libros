# 🦄 .env.example - Copia a .env y rellena

# Conexión a PostgreSQL
# En Docker local: postgresql://dev:dev@postgres:5432/book_recommendations
# En Render: postgresql://user:pass@dpg-xxx.regional.com/dbname
DATABASE_URL=postgresql://dev:dev@postgres:5432/book_recommendations

# Llave secreta para JWT (generar algo aleatorio y largo)
# Puedes usar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here-change-this

# Frontend URL (para CORS si es necesario)
FRONTEND_URL=http://localhost:3000
